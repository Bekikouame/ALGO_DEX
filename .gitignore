# ALGO_DEX : moteur Django (django-docker/) + cockpit Next.js (frontend/)

# --- Secrets et configuration locale ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Système et éditeurs ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Python / Django ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version.local
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Base SQLite de développement (et ses fichiers WAL)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Fichiers collectés ou envoyés par Django
staticfiles/
media/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
.turbo/

# --- Journaux ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ancienne copie de dépôt Git, sans rapport avec le projet
django-docker/.git_backup/

# Exports de la base de production
deploiement/sauvegardes/
