# Moteur Django — variables de production. Copier en .env (jamais commité) et remplir.

# Obligatoire en production : DJANGO_DEBUG=0 et une clé secrète unique d'au moins 50 caractères.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g()+g())"
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=algodex.exemple.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://algodex.exemple.fr

# Adresse du back-office (par défaut admin/) : en choisir une difficile à deviner, terminée par /.
DJANGO_CHEMIN_ADMIN=gestion-algodex/

# HTTPS assuré par un reverse proxy (Nginx, Caddy…) qui envoie X-Forwarded-Proto.
DJANGO_DERRIERE_HTTPS=1
DJANGO_REDIRECTION_HTTPS=1
DJANGO_HSTS_SECONDES=31536000

# Nombre de relais devant Django (1 : Next, qui relaie /api/*). Django ne doit pas être exposé directement.
DJANGO_NB_PROXIES=1
DJANGO_LIMITE_APPRENANT=600/min
DJANGO_LIMITE_CREATION_PROFIL=60/hour

# Base PostgreSQL (sans POSTGRES_DB, SQLite est utilisé).
POSTGRES_DB=algodex
POSTGRES_USER=algodex
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
