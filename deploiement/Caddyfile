# Seule porte d'entrée publique : HTTPS automatique (Let's Encrypt).
# Le back-office n'existe que sur {$DOMAINE_ADMIN}, jamais sur l'adresse des apprenants {$DOMAINE}.

{$DOMAINE} {
	encode zstd gzip

	# Requêtes JSON de quelques kilo-octets : au-delà, c'est un abus.
	request_body {
		max_size 512KB
	}

	# Routes d'administration du moteur : introuvables depuis l'adresse publique.
	@administration path /api/exercices /api/exercices/* /api/docs /api/docs/* /api/schema /api/schema/* /api/redoc /api/redoc/*
	respond @administration 404

	# Pages et /api/* passent par le site Next.
	reverse_proxy site:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

{$DOMAINE_ADMIN} {
	encode zstd gzip

	@backoffice path /{$DJANGO_CHEMIN_ADMIN}* /static/* /api/exercices /api/exercices/* /api/docs /api/docs/* /api/schema /api/schema/* /api/redoc /api/redoc/*
	handle @backoffice {
		reverse_proxy moteur:8000
	}
	respond 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
